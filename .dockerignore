# =============================================================================
# Docker Build Ignore File (Monorepo Root)
# =============================================================================
# Optimized for Turborepo prune + Docker builds
# These files are excluded from the Docker build context

# Git
.git
.gitignore

# Turbo cache (will be regenerated by turbo prune)
.turbo
**/turbo

# Node modules (npm ci will install fresh)
**/node_modules

# Build outputs (built inside Docker)
**/dist
**/build
**/.next

# Development files
**/.env
**/.env.*
!**/.env.example

# Editor/IDE
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Test/Coverage
/tests
**/coverage
**/.nyc_output

# Logs
**/logs
**/*.log
npm-debug.log*

# Documentation (not needed in container)
docs
**/*.md
!services/backend/config/**/*.md
!services/backend/templates/**/*.md
!**/drizzle/*.md

# Repo-local research, agent, and integration app sources are not needed by the
# backend production image. Provider app images build from their own contexts.
/services/evaluation-lab
/references
/integrations
/.claude
/.codex
/.local
/.null

# Local development files (root-level only, not src/shared/storage)
storage
services/backend/storage
**/.agent

# Temporary files
**/tmp
**/temp

# Security Research Lab: internal-only, never ships in a product image (PRD 5).
/services/research-lab
