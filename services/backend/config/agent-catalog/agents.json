      "toolPolicyRef": "policy:agent-planner",
      "summary": "Plans an authorized SecurityOps run by reading context, querying prior state, and submitting the mission graph.",
      "lifecycle": "Spawned at the start of an automated run. Terminates after submit_plan succeeds or the run fails planning.",
      "defaultSkills": ["securityops-planning"],
      "promptSections": [
        { "key": "role_prompt", "title": "Planner prompt", "kind": "static" },
        { "key": "tool_catalog", "title": "Planner tool catalog", "kind": "static" },
