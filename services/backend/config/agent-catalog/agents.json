      "lifecycle": "Spawned by an entitled Verify action. Terminates after submit_exposure_verification records a bound verdict.",
      "defaultSkills": ["cve-verification"],
      "promptSections": [
        { "key": "role_prompt", "title": "Exposure verification prompt", "kind": "static" },
