        { "key": "automation_contract", "title": "Automation contract", "kind": "dynamic" }
      ],
      "inputs": ["Run goal", "Organization context", "Scope and RoE", "Prior findings, notes, and inventory"],
      "outputs": ["submit_plan mission graph", "Planner notes and readiness rationale"],
      "notes": [
        "submit_plan validates phases, skills, readiness, and duplicate attempts before execution can start."
