# =============================================================================
# Null-AI Backend Environment Variables
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NEVER commit .env with real secrets!
# Most settings are DB-backed (seeded from config/seeds/settings/).
# Secrets, instance-specific URLs, and a bounded direct-runtime override surface remain as env vars.
# =============================================================================

# === Core Runtime ===
NODE_ENV=development
PORT=3001
APP_ROLE=worker
ENABLE_WORKERS=true

# === Private Runner Command Generation ===
# Base API URL injected into private runner install commands shown in UI.
RUNNER_API_URL=http://localhost:3001
# Image used in generated private runner install commands: the sandbox image, whose default
# command starts the runner bridge (services/shell-server). Unset: null-ai-sandbox:local, the image
# `docker compose up` builds. Set it to an image in a registry you use to run a runner elsewhere.
# RUNNER_IMAGE=
# The network every sandbox joins. The agent's commands run there, and so does its browser: Chromium runs
# inside the session's sandbox and the backend only drives it, never loading a page itself.
# null-ai-sandbox is the sealed network whose only way out is sandbox-gateway: the internet and the lab,
# nothing private. docker compose and `npm run dev` both use it (npm run dev starts the gateway). Unset,
# sandboxes join Docker's default bridge, without the seal: the agent's commands and its browser could reach
# this computer and your network. The backend says so once, when the first such sandbox starts.
SANDBOX_NETWORK=null-ai-sandbox

# --- Threat Watch (continuous CVE exposure) -----------------------------------
# Enablement, cadence, page budget, thresholds, and notifications are
# audited database settings. Only the API key is secret.
# Free from https://nvd.nist.gov/developers/request-an-api-key
# Keyless is 5 requests / 30s; a key raises it to 50. A cold backfill walks ~77
# windows, so keyless turns hours into days.
THREAT_WATCH_NVD_API_KEY=

# === Web Search (Optional) ===
# Provider defaults come from DB seed; these env vars override local/runtime behavior.
# Put real local Tavily secret in .env.local.
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_BASE_URL=https://api.tavily.com/search
TAVILY_API_KEY=

# === Out-of-Band Callback Ingress (Optional) ===
# Point the backend at your own interactsh server. docker compose does not run
# one, because real blind callbacks need public DNS and inbound ports.
#
# INTERACTSH_SERVER_URL=http://oast.example.com
# INTERACTSH_SERVER_AUTH_TOKEN=<your interactsh token>
# INTERACTSH_CALLBACK_DOMAIN=oast.example.com
# INTERACTSH_CALLBACK_SCHEME=http
# INTERACTSH_POLL_INTERVAL_SECONDS=10
# OOB_TOKEN_DEFAULT_TTL_SECONDS=3600
# OOB_TOKEN_MAX_TTL_SECONDS=86400

# === Model API Keys ===
# Put your own key here or in .env.local, then run npm run db:seed.
QWEN_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=

# === Database ===
# Local: `docker compose up -d dev-ports` runs Postgres on 127.0.0.1:25432 and storage on :29000
DATABASE_URL=postgresql://null_ai:null_ai@127.0.0.1:25432/null_ai
DB_POOL_MAX=10

# === Test Database (for local integration tests) ===
# Uses the same Postgres instance but different database
TEST_DATABASE_URL=postgresql://null_ai:null_ai@127.0.0.1:25432/null_ai_test
TEST_S3_ENDPOINT=http://127.0.0.1:29000
TEST_S3_ACCESS_KEY=null_ai
TEST_S3_SECRET_KEY=null_ai_storage
TEST_S3_ARTIFACTS_BUCKET=nullai-test-artifacts
TEST_S3_TRACES_BUCKET=nullai-test-traces

# === Workspace / Storage ===
WORKSPACE_ROOT=/var/lib/nullai/workspaces
WORKSPACE_OBJECT_STORE_DIR=storage/object-store

# === S3-compatible storage ===
# Local: `docker compose up -d dev-ports` publishes storage on 127.0.0.1:29000
S3_ENDPOINT=http://127.0.0.1:29000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:29000
S3_REGION=us-east-1
S3_ACCESS_KEY=null_ai
S3_SECRET_KEY=null_ai_storage
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKETS=true
S3_BUCKET_ARTIFACTS=nullai-artifacts
S3_BUCKET_TRACES=nullai-traces
S3_BUCKET_WORKSPACES=nullai-workspaces

# === Encryption keys (Optional) ===
ACCESS_MATERIALS_ENCRYPTION_KEY=
# Optional separate key for model provider API-key encryption.
# If unset, ACCESS_MATERIALS_ENCRYPTION_KEY is used.
MODEL_API_KEY_ENCRYPTION_KEY=

# === Logging ===
LOG_LEVEL=info
LOG_PRETTY=true
LOG_VERBOSE_SESSION=false
LOG_INCLUDE_DOCKER=false

# === Performance Summaries (Optional) ===
# Your own Prometheus, if you run one. Null AI does not start one.
PROMETHEUS_URL=http://localhost:9090
PERFORMANCE_SUMMARY_ENABLED=true
PERFORMANCE_QUERY_TIMEOUT_MS=2500
PERFORMANCE_QUERY_MAX_RANGE_HOURS=24
PERFORMANCE_QUERY_STEP_SECONDS=30
# Live per-container sampling via `docker stats` (works without cAdvisor; ideal for dev/WSL2).
PERFORMANCE_DOCKER_STATS_ENABLED=true
PERFORMANCE_DOCKER_STATS_INTERVAL_MS=5000

# =============================================================================
# SETTINGS NOW IN DATABASE (seeded from config/seeds/settings/):
# - APPROVAL_MODE, APPROVAL_TIMEOUT_MS → approval-settings.seed.json
# - TURN_TIMEOUT_MS, SHELL_TIMEOUT_MS → runtime-settings.seed.json
# - SANDBOX_* → sandbox-settings.seed.json, except SANDBOX_NETWORK which is compose/runtime-specific
# - TRACE_* → trace-settings.seed.json
# - CORS_*, ALLOW_OUTBOUND → network-settings.seed.json
# - Model catalog metadata -> models.seed.json
# - Model provider API keys -> this file or .env.local
# =============================================================================
SECURITYOPS_EXPLOITATION_V1_ENABLED=false
SECURITYOPS_EXPLOITATION_V1_ORG_IDS=
SECURITYOPS_ENUMERATION_WORKER_V1_ENABLED=false
SECURITYOPS_ENUMERATION_WORKER_V1_ORG_IDS=
SECURITYOPS_ENUMERATION_WORKER_V1_ROLLOUT_PERCENT=0
COMPLIANCE_AGENT_WORKFLOW_ENABLED=true
COMPLIANCE_EVIDENCE_UPLOAD_MAX_BYTES=26214400
COMPLIANCE_EVIDENCE_STORAGE_ROOT=storage/compliance-evidence

# === Who you are ===
# Null AI has no sign-in. The person is whoever holds the owner key, made on first start and kept
# outside the repository. The backend prints a link with it when it starts; `npm run link` prints it
# again. Open it once in your browser.
# NULL_AI_HOME=~/.null-ai                 # folder for the owner key (owner-key)
# NULL_AI_OWNER_KEY_FILE=                 # or the key file itself
# NULL_AI_APP_URL=http://localhost:8081   # where the app runs, for the printed link
# NULL_AI_CODE_ROOT=                      # a scope's code folder must sit inside this folder (unset: any folder)
# NULL_AI_LAB_TARGETS=                    # practice targets that verify as "lab", comma-separated (compose: juice-shop.lab)
