    },
    {
      "title": "Requests by Provider",
      "type": "piechart",
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "legend": { "displayMode": "table", "placement": "right" }, "pieType": "pie" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(llm_request_latency_ms_count) by (provider)", "legendFormat": "{{provider}}" }]
    },
    {
      "title": "Requests by Model",
      "type": "piechart",
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "legend": { "displayMode": "table", "placement": "right" }, "pieType": "pie" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(llm_request_latency_ms_count) by (model)", "legendFormat": "{{model}}" }]
    },
    {
      "title": "LLM Latency by Provider (p95)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum(rate(llm_request_latency_ms_bucket[$__rate_interval])) by (le, provider))", "legendFormat": "{{provider}}" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "id": 103,
      "panels": [],
      "title": "🔧 Tool Usage",
      "type": "row"
    },
    {
      "title": "Tool Executions by Tool",
      "type": "bargauge",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(tool_exec_total) by (tool)", "legendFormat": "{{tool}}" }]
    },
    {
      "title": "Tool Latency (p95) by Tool",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum(rate(tool_exec_latency_ms_bucket[$__rate_interval])) by (le, tool))", "legendFormat": "{{tool}}" }]
    },
    {
      "title": "Tool Success Rate",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.9 }, { "color": "green", "value": 0.99 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(tool_exec_total{status=\"ok\"}) / sum(tool_exec_total)", "legendFormat": "" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "id": 104,
      "panels": [],
      "title": "❌ Errors & Issues",
