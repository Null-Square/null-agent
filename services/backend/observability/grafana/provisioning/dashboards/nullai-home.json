    },
    {
      "title": "S3 Storage",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }] } },
      "options": { "colorMode": "value", "graphMode": "none" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "s3_health{bucket=\"artifacts\"}", "legendFormat": "Artifacts" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "s3_health{bucket=\"traces\"}", "legendFormat": "Traces" }
      ]
    },
    {
      "title": "Scheduler",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "scheduler_status{metric=\"pending_runs\"}", "legendFormat": "Pending" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "scheduler_status{metric=\"running_runs\"}", "legendFormat": "Running" }
      ]
    },
    {
      "title": "Active Sessions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
