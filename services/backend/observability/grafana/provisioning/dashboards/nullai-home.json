      "options": { "colorMode": "value", "graphMode": "area" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "active_sessions", "legendFormat": "" }]
    },
    {
      "title": "Resume Queue",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
