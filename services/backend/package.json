{
  "name": "backend-service",
  "version": "1.0.0",
  "description": "Backend service for Null AI",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx ./scripts/dev.ts",
    "dev:server": "ts-node-dev -r tsconfig-paths/register src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit:alignment && tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:unit:alignment": "tsx ./scripts/check-unit-test-tree-alignment.ts",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "RUN_E2E_TESTS=1 vitest run tests/e2e",
    "test:smoke": "node ./scripts/run-tool-smoke-tests.js",
    "test:smoke:oob-dev": "node ./scripts/run-oob-dev-parity-smoke.js",
    "test:behavior": "tsx ./scripts/run-behavior-smoke-tests.ts",
    "test:behavior:list": "tsx ./scripts/run-behavior-smoke-tests.ts --list",
    "test:behavior:live": "tsx ./scripts/run-behavior-smoke-tests.ts --live",
    "test:behavior:assembled": "vitest run tests/behavior/assembledRuntime.test.ts",
    "test:behavior:assembled:run": "tsx ./scripts/run-behavior-smoke-tests.ts --assembled",
    "test:behavior:assembled:list": "tsx ./scripts/run-behavior-smoke-tests.ts --assembled --list",
    "test:behavior:composition": "tsx ./scripts/run-behavior-smoke-tests.ts --assembled --scenario harness-shipping-composition-joins-the-evidence-chain --output tests/behavior/results/shipping-composition-latest.json",
    "test:behavior:tool-truth": "tsx ./scripts/run-behavior-smoke-tests.ts --assembled --scenario harness-tool-truth-execution-observation-and-route --output tests/behavior/results/tool-truth-latest.json",
    "test:behavior:conformance": "tsx ./scripts/run-behavior-smoke-tests.ts --assembled --scenario harness-3-2-conformance-cache-economics --output tests/behavior/results/harness-3.2-conformance-latest.json",
    "test:behavior:conformance:live": "tsx ./scripts/run-behavior-smoke-tests.ts --assembled --live --scenario harness-3-2-conformance-cache-economics --output tests/behavior/results/harness-3.2-conformance-live.json",
    "test:behavior:release": "tsx ./scripts/run-behavior-smoke-tests.ts --assembled --scenario harness-3-2-assembled-restart-integrity-canary --output tests/behavior/results/harness-3.2-release-latest.json",
    "test:contract": "vitest run tests/contract",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --max-warnings=0",
    "lint:fix": "eslint src/ --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "node ./scripts/reset-db.js",
    "db:seed": "tsx ./scripts/seed.ts",
    "link": "tsx ./scripts/print-owner-link.ts",
    "db:seed:all": "tsx ./scripts/seed.ts --include-optional",
    "db:seed:compliance-evidence": "tsx ./scripts/seed-compliance-evidence.ts",
    "skills:verify": "tsx ./scripts/verify-b1-release.ts",
    "threat-watch:nvd-smoke": "tsx ./scripts/threat-watch/nvd-smoke.ts",
    "threat-watch:backfill": "tsx ./scripts/threat-watch/backfill-advisories.ts",
    "threat-watch:gate0": "tsx ./scripts/threat-watch/gate0-coverage.ts",
    "threat-watch:gate0:persisted": "tsx ./scripts/threat-watch/gate0-coverage.ts --persisted",
    "threat-watch:pipeline-smoke": "vitest run tests/unit/db/postgresAdvisoryLock.test.ts tests/unit/domains/security-ops/advisories/threatWatchHealth.test.ts tests/unit/domains/security-ops/advisories/NvdClient.test.ts tests/unit/domains/security-ops/advisories/advisorySyncPlan.test.ts tests/unit/domains/security-ops/advisories/AdvisorySyncService.test.ts tests/unit/domains/security-ops/exposure/ThreatWatchCycleService.test.ts tests/unit/domains/security-ops/exposure/ExposureNotifier.test.ts tests/unit/domains/security-ops/runs/StartRunRuntimeService.code-review.test.ts tests/unit/domains/security-ops/runs/StartRunService.test.ts tests/unit/domains/security-ops/runs/RunRuntimeStatusService.test.ts tests/unit/domains/agent-brain/domain/prompts/SystemPromptBuilder.test.ts tests/unit/domains/agent-brain/application/orchestration/services/AutomationDecisionEngine.test.ts tests/integration/security-ops/AdvisoryRepository.integration.test.ts tests/integration/security-ops/ExposureVerification.integration.test.ts",
    "skills:runtime-snapshot": "tsx ./scripts/generate-runtime-skill-catalog.ts",
    "skills:runtime-snapshot:write": "tsx ./scripts/generate-runtime-skill-catalog.ts --write",
    "skills:enumeration-eligibility": "tsx ./scripts/generate-enumeration-worker-eligibility.ts",
    "skills:enumeration-eligibility:write": "tsx ./scripts/generate-enumeration-worker-eligibility.ts --write",
    "lint:config": "tsx ./scripts/lint-config-usage.ts",
    "generate:openapi": "tsx ./scripts/generate-openapi.ts",
    "catalog:policies": "tsx ./scripts/generate-agent-catalog-policies.ts",
    "catalog:policies:check": "tsx ./scripts/generate-agent-catalog-policies.ts --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.73.0",
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@aws-sdk/client-s3": "^3.669.0",
    "@aws-sdk/s3-request-presigner": "^3.669.0",
    "@null-ai/contracts": "*",
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/semantic-conventions": "1.41.1",
    "@types/marked": "5.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "archiver": "^7.0.1",
    "bullmq": "^5.63.1",
    "cors": "^2.8.5",
    "cron-parser": "^5.4.0",
    "dotenv": "^16.0.3",
    "drizzle-orm": "0.45.2",
    "express": "^4.18.2",
    "ioredis": "^5.8.2",
    "luxon": "^3.7.2",
    "marked": "17.0.1",
    "mermaid": "11.17.2",
    "multer": "^1.4.5-lts.2",
    "openai": "^6.3.0",
    "pdf-lib": "1.17.1",
    "pg": "8.18.0",
    "pino": "^9.3.2",
    "playwright-core": "1.49.0",
    "prom-client": "^15.1.3",
    "puppeteer": "25.19.0",
    "swagger-ui-express": "^5.0.1",
    "tldts": "7.4.9",
    "tsconfig-paths": "^4.2.0",
    "ulid": "^2.4.0",
    "undici": "^7.29.0",
    "uuid": "^13.0.0",
    "ws": "^8.18.3",
    "yaml": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/archiver": "^7.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.7.1",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.5",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "3.2.6",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "nodemon": "^3.0.1",
    "pino-pretty": "^11.3.0",
    "source-map": "^0.6.1",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.19.1",
    "vitest": "3.2.6"
  },
  "keywords": [
    "backend",
    "api",
    "express"
  ],
  "author": "",
  "license": "Apache-2.0",
  "type": "commonjs"
}
