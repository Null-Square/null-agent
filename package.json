{
  "name": "nullsquare-local",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Local NullSquare workspace for compliance evidence and source code review.",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/contracts",
    "packages/design-tokens",
    "services/backend",
    "services/frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace services/frontend",
    "prestart": "npm run build",
    "start": "node services/backend/server.mjs",
    "test": "npm test --workspace services/backend",
    "check": "npm run build && npm test",
    "verify": "npm run check",
    "verify:local": "npm run check && npm run test:browser",
    "test:browser": "node scripts/test-browser.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
