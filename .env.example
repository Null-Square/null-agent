# Settings for `docker compose up`. Copy this file to .env next to docker-compose.yml and fill in what
# you need; everything here is optional. Compose reads .env itself; it never enters an image.

# --- Models ----------------------------------------------------------------------------------------
# A key for any of these makes its models ready on start. With none, the app still opens and the
# agent waits until you add a model.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
QWEN_API_KEY=

# --- The app ---------------------------------------------------------------------------------------
# The app at http://localhost:<port>, on this computer only.
NULL_AI_PORT=8080

# --- Practice targets ------------------------------------------------------------------------------
# Hosts that verify as a practice target ("lab") instead of by DNS TXT or a file, comma-separated
# and matched exactly. Unset, it names the lab profile's Juice Shop (juice-shop.lab). Set it empty to
# turn this off.
# NULL_AI_LAB_TARGETS=juice-shop.lab

# --- Encryption keys -------------------------------------------------------------------------------
# Leave unset: the first start generates both into the backend's own volume and reuses them. Set one
# only before the first start (or when restoring a backup): data saved under another key is unreadable.
# Each is 32 random bytes, base64.
# ACCESS_MATERIALS_ENCRYPTION_KEY=
# MODEL_API_KEY_ENCRYPTION_KEY=

# --- Sandbox workspaces ----------------------------------------------------------------------------
# Where run workspaces live, as a path the Docker daemon sees (on Docker Desktop, inside its VM).
# The backend and each sandbox mount it at the same path.
# NULL_AI_WORKSPACE_ROOT=/var/lib/null-ai/workspaces

# --- Running the backend from source (`docker compose up -d dev-ports`) ------------------------------
# Database and storage on this computer only, for a backend outside compose.
# NULL_AI_DB_PORT=25432
# NULL_AI_STORAGE_PORT=29000

# LOG_LEVEL=info
